# Copy to .env (setup.sh does this) and fill in. .env is never committed.

# Your Zoho login
ZOHO_EMAIL=you@example.com
ZOHO_PASSWORD=your-password

# The text "setup key" shown under the QR code when you enable an authenticator app
# (Zoho Accounts > Security > Multi-Factor Authentication > Authenticator App). Spaces are fine.
ZOHO_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Zoho data centre of your account: in (India), com (US), eu, com.au, ...
ZOHO_DC=in

# Optional: your Zoho display name(s), comma-separated, scrubbed from failure evidence
REDACT_NAMES=Your Name,Yourfirstname
